# Copier vers /opt/haythi-api/.env sur le serveur (chmod 600)
# Ne jamais committer .env

NODE_ENV=production
HOST=127.0.0.1
PORT=8787

RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=HAYTHI <contact@mail.haythi.mg>
RESEND_TO=contact@haythi.mg

ALLOWED_ORIGINS=https://haythi.mg,https://www.haythi.mg

# Base SQLite (leads, back-office)
DATABASE_PATH=data/haythi.sqlite

# Quotas locaux (marge sous Resend Free 100/jour, 3000/mois)
DAILY_SEND_LIMIT=80
MONTHLY_SEND_LIMIT=2500
EMAIL_COOLDOWN_MS=3600000
IP_HOUR_MAX=30
IP_DAY_MAX=80

# Optionnel : Cloudflare Turnstile (si défini → token obligatoire)
# TURNSTILE_SECRET_KEY=

# Back-office admin (cookie haythi_admin)
# SESSION_SECRET obligatoire sauf NODE_ENV=development (sinon création/validation de session refusée).
# Cookie haythi_admin : Secure partout sauf NODE_ENV=development (dev local en HTTP).
SESSION_SECRET=change-me-long-random-string
ADMIN_ORIGIN=https://admin.haythi.mg
